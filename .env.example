# ============================================================
# .env.example — Psold Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ─── SUPABASE ───────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdXItcHJvamVjdC1pZCIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNjQwMDAwMDAwLCJleHAiOjE5NTU1NjAwMDB9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ─── FIREBASE ───────────────────────────────────────────────
# Get google-services.json from: https://console.firebase.google.com/project/YOUR_PROJECT/settings/general
# Place it at: android/app/google-services.json

# ─── GOOGLE ML KIT ──────────────────────────────────────────
# No API key needed — ML Kit on-device OCR works offline.
# Just ensure the model is bundled in assets (auto-bundled by google_mlkit_text_recognition).

# ─── GEMINI (for Edge Function validation) ──────────────────
# Set in Supabase Dashboard → Edge Functions → Environment Variables
GEMINI_API_KEY=your-gemini-api-key-here

# ─── GOOGLE SIGN-IN ─────────────────────────────────────────
# Get client ID from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── SENTRY (optional — for crash monitoring) ─────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# ─── ADMOB (optional) ───────────────────────────────────────
ADMOB_APP_ID=ca-app-pub-xxxxxxx~xxxxxxx
ADMOB_TEST_DEVICE_IDS=your-test-device-id

# ─── BUILD FLAGS ────────────────────────────────────────────
# Pass these when building:
#
#   flutter build apk --release \
#     --dart-define=SUPABASE_URL=$SUPABASE_URL \
#     --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY \
#     --dart-define=GOOGLE_CLIENT_ID=$GOOGLE_CLIENT_ID
#
# For Codemagic, add these to Environment variables in codemagic.yaml.


# ============================================================
# HOW TO SETUP EACH SERVICE — STEP BY STEP
# ============================================================

# ─── 1. SUPABASE ───────────────────────────────────────────

# Create project at https://supabase.com
# Run migration: supabase/migrations/001_initial_schema.sql
# Enable Phone auth: Authentication → Providers → Phone → Enable
# Configure SMS template: Authentication → Sms Templates
# Set redirect URI: Authentication → URL Configuration → Redirect URLs → add "psold://login-callback"

# ─── 2. FIREBASE ────────────────────────────────────────────

# 1. Create project at https://console.firebase.google.com
# 2. Add Android app: Package name = com.psold.app
# 3. Download google-services.json → place at android/app/google-services.json
# 4. Enable Firebase Authentication (Email/Password + Phone)
# 5. Enable Cloud Messaging: Project Settings → Cloud Messaging → Web Push certificates
# 6. Copy Server Key → Supabase Dashboard → Edge Functions → FCM Server Key

# ─── 3. GOOGLE SIGN-IN ──────────────────────────────────────

# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application type)
# 3. Add authorized redirect URIs: https://your-project-id.supabase.co/auth/v1/callback
# 4. Add SHA-1 fingerprint from android/app/build.gradle.kts

# ─── 4. GEMINI (Edge Function) ─────────────────────────────

# 1. Get API key at https://aistudio.google.com/apikey
# 2. Add to Supabase: Edge Functions → Environment Variables → GEMINI_API_KEY
# 3. Test locally: supabase functions serve validate-product

# ─── 5. SENTRY (crash monitoring) ──────────────────────────

# 1. Create project at https://sentry.io
# 2. Get DSN and add to .env as SENTRY_DSN
# 3. Add to pubspec.yaml: sentry_flutter: ^8.0.0
# 4. Initialize in main.dart before runApp()

# ─── 6. ADMOB (optional) ───────────────────────────────────

# 1. Create AdMob account at https://apps.admob.com
# 2. Create app and ad units
# 3. Add App ID to AndroidManifest: <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="$ADMOB_APP_ID"/>
# 4. Add package: google_mobile_ads: ^5.0.0


# ============================================================
# FEATURE ENABLING CHECKLIST
# ============================================================

# After cloning the repo and adding credentials:

# 1. Supabase Auth (email/password)
#    → Set SUPABASE_URL + SUPABASE_ANON_KEY → Run flutter run

# 2. OTP Phone login
#    → Enable Phone provider in Supabase dashboard
#    → Configure SMS gateway (Twilio, Vonage, or Supabase built-in)

# 3. Google Sign-In
#    → Set GOOGLE_CLIENT_ID → Configure OAuth in Google Cloud Console

# 4. Firebase Push Notifications
#    → Add google-services.json → Add Server Key to Supabase FCM
#    → Request POST_NOTIFICATIONS permission at runtime

# 5. Gemini AI Validation (Edge Function)
#    → Set GEMINI_API_KEY in Supabase Edge Functions env
#    → Deploy: supabase functions deploy validate-product

# 6. ML Kit OCR (date extraction)
#    → Works out-of-the-box — no credentials needed
#    → Bundled model auto-downloads on first use

# 7. Video Player
#    → Add VideoPlayer widget in ProductCard for products with videoUrl
#    → Use Chewie or video_player package

# 8. Sentry Crash Monitoring
#    → Set SENTRY_DSN → Initialize in main.dart

# 9. Admob Monetization
#    → Set ADMOB_APP_ID → Add google_mobile_ads package

# 10. Codemagic CI/CD
#    → Follow CODEMAGIC.md (11 steps on Windows)
#    → Add environment variables in Codemagic UI


# ============================================================
# BUILD COMMANDS
# ============================================================

# Development
# flutter run

# Release APK (arm64)
# flutter build apk --release \
#   --dart-define=SUPABASE_URL=$SUPABASE_URL \
#   --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY \
#   --dart-define=GOOGLE_CLIENT_ID=$GOOGLE_CLIENT_ID

# Release APK (armeabi-v7a for older devices)
# flutter build apk --release --target-platform=android-arm \
#   --dart-define=SUPABASE_URL=$SUPABASE_URL \
#   --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY

# Web
# flutter build web --release \
#   --dart-define=SUPABASE_URL=$SUPABASE_URL \
#   --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY

# iOS (requires macOS + Xcode)
# flutter build ios --release \
#   --dart-define=SUPABASE_URL=$SUPABASE_URL \
#   --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY


# ============================================================
# IMPORTANT NOTES
# ============================================================

# • Never commit .env or google-services.json to Git
# • Supabase anon key is SAFE to expose — RLS policies protect the database
# • Service role key must NEVER be exposed to the client
# • APK size budget: <20MB (currently ~33MB arm64 — optimize with --split-per-abi)
# • ML Kit adds ~18MB to the APK (unavoidable for on-device OCR)
# • To reduce APK size: use --target-platform=android-arm64 only (~33MB)
# • For smaller APK: flutter build apk --release --target-platform=android-arm